// Falcon fuc5 conformance firmware: exact compute, driven by real interrupts.
//
// The point is an answer that can be computed independently, where a wrong
// ISA semantic or a mishandled interrupt changes the number rather than
// merely looking odd. Nothing here is timing-dependent: the program waits
// for exactly N interrupts and then stops, so irq_count is N by construction
// however fast the model runs. If interrupts never arrive, or if `iret` fails
// to restore ie0 so only the first one lands, the wait never finishes -- the
// failure is a hang, not a plausible wrong number.
//
// DMEM results:
//   0x00 irq_count   must be exactly 8
//   0x04 mix         mix = ((mix & 0xffff) * 31 + k) for k = 1..8, in order
//   0x08 sum_sq      sum of i*i for i = 1..64, computed through call/ret
//   0x0c done        every other word XORed together, written last
//   0x10 alu         a chain over and/or/xor/shl/sar/hswap/xbit/sext/not/neg
//   0x14 regs        proof that `mpush $r4` really preserved r0-r3
//   0x18 dma         a DMEM -> external -> DMEM round trip through xdst/xdld
//   0x1c tlb         ptlb/vtlb/itlb after a code load, folded together
//   0x20 sized       b8/b16 arithmetic must wrap, and set flags from bit sz-1
//   0x24 carry        adc/sbb/shlc/div/mod -- all rewritten or never executed
//   0x28 rotc         shrc, and setp writing a flag bit

// -- init ------------------------------------------------------------------
        mov $r0 0x1000
        mov $sp $r0

        clear b32 $r0
        mov $r1 0x0
        st b32 D[$r1] $r0
        mov $r1 0x4
        st b32 D[$r1] $r0
        mov $r1 0x8
        st b32 D[$r1] $r0
        mov $r1 0xc
        st b32 D[$r1] $r0
        mov $r1 0x10
        st b32 D[$r1] $r0
        mov $r1 0x14
        st b32 D[$r1] $r0
        mov $r1 0x18
        st b32 D[$r1] $r0
        mov $r1 0x1c
        st b32 D[$r1] $r0
        mov $r1 0x20
        st b32 D[$r1] $r0
        mov $r1 0x24
        st b32 D[$r1] $r0
        mov $r1 0x28
        st b32 D[$r1] $r0
        mov $r1 0x2c
        st b32 D[$r1] $r0
        mov $r1 0x30
        st b32 D[$r1] $r0
        mov $r1 0x34
        st b32 D[$r1] $r0
        mov $r1 0x38
        st b32 D[$r1] $r0
        mov $r1 0x3c
        st b32 D[$r1] $r0

// -- install the handler ---------------------------------------------------
        mov $r1 #handler
        mov $iv0 $r1

// -- unmask engine interrupt line 0 (INTR_EN_SET) --------------------------
        mov $r2 0x1
        mov $r3 0x400
        iowr I[$r3] $r2

// -- arm the periodic timer ------------------------------------------------
        mov $r2 0x64
        mov $r3 0x800
        iowr I[$r3] $r2
        mov $r3 0x900
        iowr I[$r3] $r2
        mov $r2 0x1
        mov $r3 0xa00
        iowr I[$r3] $r2

        bset $flags ie0

// -- wait for exactly 8 interrupts ----------------------------------------
wait:
        mov $r1 0x0
        ld b32 $r5 D[$r1]
        mov $r6 0x8
        cmpu b32 $r5 $r6
        bra b #wait

        bclr $flags ie0
        clear b32 $r2
        mov $r3 0xa00
        iowr I[$r3] $r2

// -- sum of squares, one call per term ------------------------------------
        clear b32 $r7
        mov $r8 0x1
sumloop:
        mov b32 $r1 $r8
        call #square
        add b32 $r7 $r7 $r2
        add b32 $r8 $r8 0x1
        mov $r9 0x41
        cmpu b32 $r8 $r9
        bra b #sumloop

        mov $r1 0x8
        st b32 D[$r1] $r7

// -- ALU chain -------------------------------------------------------------
// Every operation here was a `define pcodeop` -- a black box an emulator
// cannot execute -- or was missing outright, until this firmware needed it.
        mov $r1 0x1234
        sethi $r1 0xabcd0000
        mov $r2 0x0f0f
        sethi $r2 0x0f0f0000
        and $r3 $r1 $r2
        or $r4 $r1 $r2
        xor $r5 $r1 $r2
        add b32 $r6 $r3 $r4
        xor $r6 $r6 $r5
        shl b32 $r6 $r6 0x3
        sar b32 $r6 $r6 0x2
        hswap b32 $r0 $r6
        add b32 $r6 $r6 $r0
        xbit $r0 $r1 0x10
        add b32 $r6 $r6 $r0
        sext $r0 $r2 0x7
        add b32 $r6 $r6 $r0
        not b32 $r0 $r2
        add b32 $r6 $r6 $r0
        neg b32 $r0 $r3
        add b32 $r6 $r6 $r0
        mov $r1 0x10
        st b32 D[$r1] $r6

// -- does `mpush $r4` actually preserve r0-r3? -----------------------------
// This is the test for a semantic that is *derived*, not documented: the
// operand is read as a count, so `mpush $r4` saves r0-r3. Model it as a
// single-register push instead and `clobber` destroys the caller's values,
// this word comes out different, and the run fails here rather than silently
// computing something wrong somewhere else later.
        mov $r0 0x11
        mov $r1 0x22
        mov $r2 0x33
        mov $r3 0x44
        call #clobber
        shl b32 $r0 $r0 0x8
        add b32 $r0 $r0 $r1
        shl b32 $r0 $r0 0x8
        add b32 $r0 $r0 $r2
        shl b32 $r0 $r0 0x8
        add b32 $r0 $r0 $r3
        mov $r1 0x14
        st b32 D[$r1] $r0

// -- DMA round trip --------------------------------------------------------
// Writes a word to DMEM, stores it out to external memory with xdst, reads it
// back to a different DMEM address with xdld, and keeps what came back. The
// engine's external memory lives outside the emulator -- Falcon's SLEIGH has
// no fourth address space to put it in -- so a broken path here returns zero
// rather than the pattern.
        clear b32 $r1
        mov $xdbase $r1
        clear b32 $r1
        mov $xtargets $r1
        mov $r2 0x200
        mov $r3 0x5eed0042
        st b32 D[$r2] $r3
        clear b32 $r5
        mov $r9 0x200
        mov $r10 0x0
        shl b32 $r10 $r10 0x10
        or $r9 $r9 $r10
        xdst $r5 $r9
        xdwait
        clear b32 $r5
        mov $r9 0x280
        or $r9 $r9 $r10
        xdld $r5 $r9
        xdwait
        mov $r2 0x280
        ld b32 $r3 D[$r2]
        mov $r1 0x18
        st b32 D[$r1] $r3

// -- TLB -------------------------------------------------------------------
// A code load maps a physical page to a virtual address; ptlb reads the entry
// back, vtlb finds it by virtual address, and itlb invalidates it. The three
// results are folded so that any one of them being wrong changes the word.
        clear b32 $r1
        mov $xcbase $r1
        mov $r5 0x2200
        mov $r9 0x1000
        xcld $r5 $r9
        xcwait
        mov $r6 0x10
        ptlb $r7 $r6
        mov $r6 0x2200
        vtlb $r8 $r6
        xor $r7 $r7 $r8
        mov $r6 0x10
        itlb $r6
        ptlb $r8 $r6
        add b32 $r7 $r7 $r8
        mov $r1 0x1c
        st b32 D[$r1] $r7

// -- sized arithmetic ------------------------------------------------------
// A sized instruction computes in sz bits and takes its flags from bit sz-1
// (arith.rst: S(x) is `x >> (sz-1) & 1`). Values are chosen so their upper
// bits are already zero, so this checks the wrapping and the flags without
// depending on what a sized write does to the destination's high bits --
// which the documentation does not state.
        mov $r1 0xff
        mov $r2 0x2
        add b8 $r1 $r2                  // 0xff + 2 -> 0x01 in 8 bits, carry
        xbit $r3 $flags c             // c
        mov $r4 0xffff
        mov $r5 0x1
        add b16 $r4 $r5                 // 0xffff + 1 -> 0 in 16 bits, zero+carry
        xbit $r6 $flags z             // z
        shl b32 $r3 $r3 0x8
        or $r1 $r1 $r3
        shl b32 $r6 $r6 0xc
        or $r1 $r1 $r6
        shl b32 $r4 $r4 0x10
        or $r1 $r1 $r4
        mov $r2 0x20
        st b32 D[$r2] $r1

// -- instructions nothing had ever executed --------------------------------
// A coverage count of the conformance firmware against the shipped images
// showed 16 non-crypt instructions that no test and neither GP102 image ever
// ran -- including adc, sbb, shlc and shrc, which had just been rewritten for
// the sized-operand fix. `mov` sets no flags on v3+, so the carry set below
// survives to the instruction that consumes it.
        mov $r1 0xff
        mov $r2 0x1
        add b8 $r1 $r2                  // 0xff + 1 -> 0 in 8 bits, carry out
        mov $r3 0x10
        mov $r4 0x20
        adc b32 $r3 $r4                 // 0x10 + 0x20 + carry = 0x31
        mov $r5 0x50
        mov $r6 0x20
        cmpu b32 $r5 $r6                // 0x50 >= 0x20, so no borrow
        sbb b32 $r5 $r6                 // 0x50 - 0x20 - 0 = 0x30
        bset $flags c
        mov $r7 0x1
        mov $r8 0x1
        shlc b32 $r7 $r8                // (1 << 1) | carry = 3
        mov $r11 0x64
        div $r12 $r11 0x7               // 100 / 7 = 14
        mod $r13 $r11 0x7               // 100 % 7 = 2
        shl b32 $r5 $r5 0x8
        or $r3 $r3 $r5
        shl b32 $r7 $r7 0x10
        or $r3 $r3 $r7
        shl b32 $r12 $r12 0x18
        or $r3 $r3 $r12
        shl b32 $r13 $r13 0x1c
        or $r3 $r3 $r13
        mov $r1 0x24
        st b32 D[$r1] $r3

// rotate-through-carry the other way, then setp writing a flag bit directly
        bset $flags c
        mov $r9 0x2
        mov $r10 0x1
        shrc b32 $r9 $r10               // (2 >> 1) | (carry << 31)
        mov $r14 0x1
        setp c $r14                     // flags.c := 1
        xbit $r15 $flags c
        shl b32 $r15 $r15 0x1
        xor $r9 $r9 $r15
        mov $r1 0x28
        st b32 D[$r1] $r9

// -- mpop and mpopadd ------------------------------------------------------
// mpush/mpopret are already tested; these two are the other half of a
// derived, undocumented family. mpopadd additionally moves $sp by its
// immediate, so the value is only recovered if both the pop and the
// adjustment are right.
        mov $r0 0xa1
        mov $r1 0xb2
        mpush $r2                       // saves r0, r1
        mov $r0 0xee
        mov $r1 0xee
        mpop $r2                        // restores both
        shl b32 $r1 $r1 0x8
        or $r5 $r0 $r1                  // 0xb2a1 if mpop restored them

// mpopadd pops and *then* adds, so the bytes it reclaims sit above the saved
// block, not below it -- that is the caller-pushed-argument pattern GP102
// FECS uses. An earlier version of this allocated the frame after the mpush
// and the pop read from the wrong place.
        add $sp -0x8                    // caller's two argument words
        mov $r0 0xc3
        mpush $r1                       // saves r0
        mov $r0 0xee
        mpopadd $r1 0x8                 // pop r0, then reclaim the 8 bytes
        shl b32 $r0 $r0 0x10
        or $r5 $r5 $r0                  // 0xc3b2a1
        mov $r1 0x2c
        st b32 D[$r1] $r5

// -- a software trap -------------------------------------------------------
// intr.rst gives the delivery sequence: push $pc, save and clear the enables,
// set $tstatus to the faulting pc plus the reason, and jump to $tv.
        mov $r1 #traphandler
        mov $tv $r1
        clear b32 $r6
        trap 0x1
        mov $r1 0x30
        st b32 D[$r1] $r6

// -- signed vs unsigned compare -------------------------------------------
// arith.rst: cmps sets c "in an unusual way to enable signed comparisons
// while using unsigned flags and condition codes", so after cmps the carry
// answers signed less-than. Comparing -1 with 1 separates the two readings:
// signed says less, unsigned says greater. Both set only c and z.
        mov $r1 0x1
        neg b32 $r1 $r1                 // -1
        mov $r2 0x1
        cmps b32 $r1 $r2                // signed: -1 < 1  -> c = 1
        xbit $r3 $flags c
        cmpu b32 $r1 $r2                // unsigned: huge > 1 -> c = 0
        xbit $r4 $flags c
        bclr $flags c
        btgl $flags c                   // -> c = 1
        xbit $r5 $flags c
        xdfence
        shl b32 $r4 $r4 0x1
        or $r3 $r3 $r4
        shl b32 $r5 $r5 0x2
        or $r3 $r3 $r5
        mov $r1 0x34
        st b32 D[$r1] $r3

// -- the last instructions with no exact-answer test -----------------------
// These are all executed by the shipped GP102 images, which is weaker
// evidence than it sounds: running without crashing is not the same as
// producing a value anyone checked.
        mov $r1 0x50
        mov $r2 0x30
        sub b32 $r1 $r2                 // 0x20
        mov $r3 0x10
        cmp b32 $r3 $r3                 // equal, so z
        xbit $r4 $flags z
        mov $r5 0x2
        neg b32 $r5 $r5                 // -2
        mov $r6 0x3
        muls $r7 $r5 $r6                // signed 16x16 -> -6
        mov $r8 0xabcd
        mov $r9 0x64                    // position 4, width 4
        extr $r10 $r8 $r9               // (0xabcd >> 4) & 0xf = 0xc
        shl b32 $r4 $r4 0x8
        or $r1 $r1 $r4
        and $r7 $r7 $r2                 // keep a byte of the negative result
        shl b32 $r7 $r7 0x10
        or $r1 $r1 $r7
        shl b32 $r10 $r10 0x18
        or $r1 $r1 $r10
        mov $r2 0x38
        st b32 D[$r2] $r1

// extrs sign-extends the field it pulls out, so bit 31 separates it from extr
        mov $r8 0xabcd
        mov $r9 0x64
        extrs $r11 $r8 $r9              // 0xc sign-extended from bit 3
        shr b32 $r11 $r11 0x1f          // -> 1
// iord must read back what iowr wrote
        mov $r12 0x800
        mov $r13 0x1234
        iowr I[$r12] $r13
        iord $r14 I[$r12]               // -> 0x1234
        sleep c
// a far call whose callee returns through mpopaddret
        add $sp -0x8
        mov $r0 0x77
        lcall #farroutine
        shl b32 $r0 $r0 0x10
        or $r14 $r14 $r0
        shl b32 $r11 $r11 0x18
        or $r14 $r14 $r11
        mov $r2 0x3c
        st b32 D[$r2] $r14
        lbra #afterfar
afterfar:

// -- fold everything into the final answer --------------------------------
// Load every term from memory. An earlier version carried sum_sq in $r7
// across the DMA and TLB sections, which both use $r7 -- so the fold silently
// mixed in the TLB result twice and sum_sq not at all.
        mov $r1 0x4
        ld b32 $r3 D[$r1]
        mov $r1 0x8
        ld b32 $r4 D[$r1]
        xor $r3 $r3 $r4
        mov $r1 0x10
        ld b32 $r4 D[$r1]
        xor $r3 $r3 $r4
        mov $r1 0x14
        ld b32 $r4 D[$r1]
        xor $r3 $r3 $r4
        mov $r1 0x18
        ld b32 $r4 D[$r1]
        xor $r3 $r3 $r4
        mov $r1 0x1c
        ld b32 $r4 D[$r1]
        xor $r3 $r3 $r4
        mov $r1 0x20
        ld b32 $r4 D[$r1]
        xor $r3 $r3 $r4
        mov $r1 0x24
        ld b32 $r4 D[$r1]
        xor $r3 $r3 $r4
        mov $r1 0x28
        ld b32 $r4 D[$r1]
        xor $r3 $r3 $r4
        mov $r1 0x2c
        ld b32 $r4 D[$r1]
        xor $r3 $r3 $r4
        mov $r1 0x30
        ld b32 $r4 D[$r1]
        xor $r3 $r3 $r4
        mov $r1 0x34
        ld b32 $r4 D[$r1]
        xor $r3 $r3 $r4
        mov $r1 0x38
        ld b32 $r4 D[$r1]
        xor $r3 $r3 $r4
        mov $r1 0x3c
        ld b32 $r4 D[$r1]
        xor $r3 $r3 $r4
        mov $r1 0xc
        st b32 D[$r1] $r3
        exit

// -- a callee that returns through mpopaddret ------------------------------
// The caller allocates two argument words before the call; mpopaddret pops
// the saved registers and then reclaims them, which is the shape GP102 FECS
// uses at 0x1be1.
farroutine:
        mpush $r1                       // saves r0
        mov $r0 0xee
        mpopaddret $r1 0x8

// -- trap handler: record the reason from $tstatus, then return ------------
// $tstatus is `faulting pc | reason << 20`. Keeping only the reason makes the
// check independent of where the trap instruction happens to sit.
traphandler:
        mov $r7 $tstatus
        shr b32 $r7 $r7 0x14
        mov $r6 0x1
        shl b32 $r6 $r6 0x8
        or $r6 $r6 $r7                  // 0x100 | reason
// intr.rst pushes the *faulting* pc, not the one after it, so returning
// straight away re-executes the trap and loops forever. Stepping the stacked
// address over the 2-byte `trap` is the handler's job, and doing it here also
// puts the pushed value itself under test.
        pop $r8
        add b32 $r8 $r8 0x2
        push $r8
        iret

// -- saves r0-r3 via mpush, destroys them, restores them on the way out ----
clobber:
        mpush $r4
        mov $r0 0xde
        mov $r1 0xad
        mov $r2 0xbe
        mov $r3 0xef
        mpopret $r4

// -- $r2 = $r1 * $r1. Uses the DMEM stack for both push/pop and ret, which
//    is the mix that catches a call pushing into the wrong address space.
square:
        push $r1
        mulu $r2 $r1 $r1
        pop $r1
        ret

// -- interrupt handler -----------------------------------------------------
// Interrupt entry saves only ie0/ie1 into is0/is1 (intr.rst); the ALU flags
// are NOT saved, on hardware or here. The handler's own `add` would otherwise
// overwrite the c flag that the wait loop's `cmpu` just set, and the loop
// would fall through early -- which is exactly what happened the first time
// this ran. Saving and restoring $flags is the firmware's job, and it also
// puts `mov $rX $flags` / `mov $flags $rX` under test in both directions.
handler:
        push $r1
        push $r2
        push $r3
        push $r4
        mov $r4 $flags
        mov $r1 0x0
        ld b32 $r2 D[$r1]
        add b32 $r2 $r2 0x1
        st b32 D[$r1] $r2
        mov $r1 0x4
        ld b32 $r3 D[$r1]
        mov $r1 0x1f
        mulu $r3 $r3 $r1
        add b32 $r3 $r3 $r2
        mov $r1 0x4
        st b32 D[$r1] $r3
        mov $r1 0x1
        mov $r2 0x100
        iowr I[$r2] $r1
        mov $flags $r4
        pop $r4
        pop $r3
        pop $r2
        pop $r1
        iret
